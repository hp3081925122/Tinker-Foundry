    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_side", "y": 90}, "when": {"east": "true"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_noside_alt"}, "when": {"east": "false"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_noside_edge", "y": 90}, "when": {"east": "false", "north": "false", "south": "false"}}
  ]
