{
  "multipart": [
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_side"}, "when": {"north": "true"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_noside"}, "when": {"north": "false"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_noside_edge"}, "when": {"east": "false", "north": "false", "west": "false"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_side_alt"}, "when": {"south": "true"}},
    {"apply": {"model": "tinker_foundry:block/seared_soul_glass_pane_noside_alt", "y": 90}, "when": {"south": "false"}},
